{
  "name": "r3-square-attendance",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "r3-square-attendance",
      "database_id": "a6b2e6d2-3128-46bc-b295-4a88d336920a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "30 6 * * *",
      "30 14 * * *"
    ]
  },
  "build": {
    "command": "node scripts/build-pages.mjs"
  },
  "send_email": [
    {
      "name": "REPORT_EMAIL",
      "allowed_destination_addresses": [
        "senthil@r3square.com",
        "jeevan@r3square.com"
      ]
    }
  ]
}
